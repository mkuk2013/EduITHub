# --- Database ---
# PostgreSQL connection string used by Prisma.
# Example: postgresql://user:password@localhost:5432/edu_it_hub?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/edu_it_hub?schema=public"

# --- Auth (Auth.js / next-auth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Admin bootstrap (used ONLY by `npm run db:seed`) ---
# The seed script creates/updates the admin user from these values.
ADMIN_EMAIL="admin@eduithub.academy"
ADMIN_PASSWORD="change-me-immediately"

# --- Email (SMTP, used by lib/email.ts) ---
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="Edu IT Hub Academy <no-reply@eduithub.academy>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Uploads ---
# Directory (relative to project root) where payment proofs / avatars are stored.
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_MB="5"
